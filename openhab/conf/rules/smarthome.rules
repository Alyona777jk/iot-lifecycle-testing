// Правило з Завдання 8.2: Сценарні режими
rule "Сценарні режими"
when
    Item SceneMode received command
then
    val scene = receivedCommand.toString
    logInfo("Scenes", "Активація сценарію: " + scene)
    switch(scene) {
        case "MORNING": {
            AllLights.sendCommand(ON)
            LivingRoomBrightness.sendCommand(80)
            KitchenLightBrightness.sendCommand(70)
            TargetTemperature.sendCommand(22.0)
        }
        case "DAY": {
            AllLights.sendCommand(OFF)
            TargetTemperature.sendCommand(20.0)
        }
        case "EVENING": {
            LivingRoomLight.sendCommand(ON)
            LivingRoomBrightness.sendCommand(60)
            KitchenLightBrightness.sendCommand(40)
            TargetTemperature.sendCommand(22.5)
        }
        case "NIGHT": {
            AllLights.sendCommand(OFF)
            KitchenLightBrightness.sendCommand(0)
            TargetTemperature.sendCommand(19.0)
        }
    }
end

// Правило з Завдання 8.1: Нічне обмеження яскравості для Кухні
rule "Автоматичне обмеження яскравості кухні вночі"
when
    Item KitchenLightBrightness changed
then
    val hour = now.getHour()
    if (hour >= 22 || hour < 6) {
        if (KitchenLightBrightness.state as Number > 30) {
            logInfo("KitchenRules", "Нічний час: обмеження яскравості кухні до 30%")
            KitchenLightBrightness.sendCommand(30)
        }
    }
end

// Додаткове завдання 9.2: Корекція температури за погодним API
rule "Погодна корекція температури"
when
    Item OutdoorTemperature changed
then
    val Number outdoorTemp = OutdoorTemperature.state as Number
    if (outdoorTemp < 0) {
        logInfo("WeatherCompensation", "Мороз надворі (" + outdoorTemp + "°C). Підвищуємо опалення до 23°C.")
        TargetTemperature.sendCommand(23.0)
    } else if (outdoorTemp > 25) {
        logInfo("WeatherCompensation", "Спека надворі (" + outdoorTemp + "°C). Знижуємо опалення до 20°C.")
        TargetTemperature.sendCommand(20.0)
    }
end
